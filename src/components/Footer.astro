---
import { Image } from "astro:assets";
import FacebookLogo from "../../public/icons/facebook.svg";
---

<footer>
    <div class="footer-container">
        <div class="footer-column">
            <Image
                src="/logo.png"
                alt="europa2000"
                width={128}
                height={128}
                format="webp"
                class="logo-button"
            />
            <span class="paragraph-text-light">© 1992-2025 Európa 2000 Gimnázium</span>
        </div>
        <div class="footer-column">
            <div>
                <span class="footer-column-title subtitle-text-light">Key Links</span>
            </div>
            <div>
                <span class="paragraph-text-light">Link1</span>
            </div>
            <div>
                <span class="paragraph-text-light">Link2</span>
            </div>
            <div>
                <span class="paragraph-text-light">Link3</span>
            </div>
        </div>
        <div class="footer-column">
            <span class="footer-column-title subtitle-text-light">Social</span>
            <div class="social-icons-row">
                <FacebookLogo/>
            </div>
        </div>
    </div>
</footer>
<style>
    .footer-container {
        background-color: var(--Blue3);
        height: 400px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        padding-top: 40px;

        .footer-column {
            justify-items: center;
            text-align: center;

            .footer-column-title {
                color: #8e8e93 !important;
            }
        }
    }
</style>
