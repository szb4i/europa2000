---
import { Image } from "astro:assets";
import FacebookLogo from "../../public/icons/facebook.svg";
import YoutubeLogo from "../../public/icons/youtube.svg";
import InstagramLogo from "../../public/icons/instagram.svg";
---

<footer>
    <div class="footer-container">
        <div class="footer-column">
            <Image
                src="/logo.png"
                alt="europa2000"
                width={128}
                height={128}
                format="webp"
                class="logo-button"
            />
            <span class="paragraph-text-light"
                >© 1992-2025 Európa 2000 Gimnázium</span
            >
        </div>
        <div class="footer-column">
            <div class="links-container">
                <div>
                    <span class="footer-column-title subtitle-text-light"
                        >Fontos linkek</span
                    >
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Főoldal</span>
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Az iskola</span>
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Felvételi</span>
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Iskolai élet</span>
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Pályázatok</span>
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Alumni</span>
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Kapcsolat</span>
                </div>
            </div>
        </div>
        <div class="footer-column">
            <div class="documents-container">
                <div>
                    <span class="footer-column-title subtitle-text-light"
                        >Dokumnentumok</span
                    >
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light"
                        >Adatvédelmi nyilatkozat</span
                    >
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Etika</span>
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Cookie szabályzat</span>
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Impresszum</span>
                </div>
                <div class="key-link">
                    <span class="paragraph-text-light">Jogi közlemény</span>
                </div>
            </div>
        </div>
        <div class="footer-column">
            <span class="footer-column-title subtitle-text-light">Social</span>
            <div class="social-icons-row">
                <FacebookLogo />
                <InstagramLogo />
                <YoutubeLogo />
            </div>
        </div>
    </div>
</footer>
<style>
    .footer-container {
        background-color: var(--Blue3);
        height: 400px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        padding-top: 40px;

        .footer-column {
            justify-items: center;
            text-align: center;

            .footer-column-title {
                color: #8e8e93 !important;
            }
        }

        .links-container {
            width: 150px;
            text-align: left;

            .key-link {
                cursor: pointer;
            }
        }

        .documents-container {
            width: 200px;
            text-align: left;

            .key-link {
                cursor: pointer;
            }
        }

        .social-icons-row {
            gap: 10px;
            display: flex;
            scale: 0.5;
        }
    }
</style>
