---
type Props = {
    isMobile?: boolean;
};

const { isMobile } = Astro.props;

const menuButtonSize = isMobile ? "70px" : "76px";
---

<div class="menu-button">
    <div class="background-image-layer">
        <div class="line line-top"></div>
        <div class="line line-middle"></div>
        <div class="line line-bottom"></div>
    </div>
</div>
<script>
    const clickListenerCallback = (event: PointerEvent) => {
        const menuContainer = document.querySelector(".menu-container");
        const menuItems = document.querySelectorAll(".menu-item");
        const menuButton  = (event.target as HTMLElement).parentNode;
        event;
        if (menuContainer.classList.contains("menu-closed")) {
            menuButton.classList.add("menu-button-active");
            menuContainer.classList.remove("menu-closed");
            menuItems.forEach((element) => {
                element?.classList.remove("menu-closed");
            });
        } else {
            menuButton.classList.remove("menu-button-active");
            menuContainer.classList.add("slide-out-500");
            setTimeout(() => {
                menuContainer.classList.add("menu-closed");
                menuContainer.classList.remove("slide-out-500");
            }, 500);
            menuItems.forEach((element) => {
                element?.classList.add("menu-closed");
            });
        }
    };
    document
        .querySelector("header .hidden-on-mobile .menu-button")
        .addEventListener("click", clickListenerCallback);
    document
        .querySelector("header .hidden-on-desktop .menu-button")
        .addEventListener("click", clickListenerCallback);
</script>
<style define:vars={{ menuButtonSize }}>
    .menu-button {
        background-color: #8bc444;
        height: var(--menuButtonSize);
        width: var(--menuButtonSize);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;

        .background-image-layer {
            display: grid;
            grid-template-rows: 1fr 1fr 1fr;
            align-items: center;
            justify-content: center;
            height: 100%;
            background-image: url("/europa2000-menu-button.png");
            background-size: 66% 66%;
            background-repeat: no-repeat;
            background-position: center;

            .line {
                background: var(--Grays-White, #fff);
                height: 2px;
            }

            .line-top {
                width: 60px;
            }

            .line-middle {
                width: 40px;
                transition: width 1s;
            }

            .line-bottom {
                width: 20px;
                transition: width 1s;
            }
        }
    }

    .menu-button-active {
        .line-middle {
            width: 60px !important;
        }

        .line-bottom {
            width: 60px !important;
        }
    }

    @media (width >=1200px) {
        .menu-button:hover {
            transform: scale(1.1);
        }
    }
</style>
