---
import Logo from "../../public/icons/facebook.svg";
---

<div class="card-container">
    <div class="card-image"></div>
    <div class="card-content">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua ...
    </div>
    <div class="card-footer">
        <div class="card-footer-date">2025.01.01</div>
        <div class="card-footer-social-icon"><Logo /></div>
    </div>
</div>
<style>
    .card-container {
        width: 280px;
        height: 400px;
        overflow: hidden;
        background-color: #f1f0e6;
        border-radius: 10px;
        box-shadow: 16px 16px 8px 0px rgba(0, 0, 0, 0.25);
        color: --var(--Blue4);
        font-family: "Raleway", sans-serif;
        font-size: 16px;

        .card-image {
            height: 240px;
            background-image: url("/hireink/hir-1.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .card-content {
            height: 134px;
            padding: 6px 6px 0px 6px;
        }

        .card-footer {
            height: 26px;
            display: grid;
            grid-template-columns: 240px 40px;

            .card-footer-date {
                padding-left: 6px;
            }
        }
    }
</style>
