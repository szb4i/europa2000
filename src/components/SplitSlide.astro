---
import { Image } from "astro:assets";

type Props = {
    isTextOnRight?: boolean;
    textTitle: string;
    textParagraph: string;
    imageURL: string;
};

const {
    isTextOnRight = false,
    textTitle,
    textParagraph,
    imageURL,
} = Astro.props;
---

<div class="split-slide-container" style={`direction: ${isTextOnRight ? 'ltr' : 'rtl'};`}>
    <div
        class="split-slide-image-side"
        style={`background-image: url(${imageURL});`}
    >
    </div>
    <div class="split-slide-logo-side">
        <div class="split-slide-text-container">
            <div class="split-slide-text-title title-text-dark">
                <span>{textTitle}</span>
            </div>
            <div class="split-slide-text-paragraph large-paragraph-text-dark">
                <span> {textParagraph}</span>
            </div>
        </div>
        <div class="split-slide-logo-container">
            <Image
                src="/europa2000-menu-button.png"
                alt="rhythm nation logo"
                width={128}
                height={128}
                format="webp"
            />
        </div>
    </div>
</div>
<style>
    .split-slide-container {
        height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: var(--light-background-color);
    }

    @media (width <=770px) {
        .split-slide-container {
            grid-template-columns: unset;
            grid-template-rows: 1fr 1fr;
        }
    }

    .split-slide-logo-side {
        display: grid;
        grid-template-rows: 3fr 2fr;
        direction: ltr;

        .split-slide-text-container {
            align-content: center;
            padding: 0% 10%;

            .split-slide-text-title {
                padding: 16px 0px;
            }
        }

        .split-slide-logo-container {
            align-content: center;
            justify-items: center;
            opacity: 0.6;
        }
    }

    .split-slide-image-side {
        position: relative;
        background-size: cover;
        background-position: center;
    }
</style>
