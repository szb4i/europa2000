---
type Props = {
    menuItemLabel: string;
    path?: string;
};

const { menuItemLabel, path='' } = Astro.props;
---

<div class="menu-item menu-closed slide-in-750">
    <a class="large-paragraph-text-light" href={path}>{menuItemLabel}</a>
</div>
<style>
    .menu-item {
        width: 100%;
    }

    .menu-item:hover {
        cursor: pointer;
    }

    .menu-closed {
        display: none;
    }

    .slide-in-750 {
        opacity: 0;
        animation: slideInFromRight 750ms ease-out forwards;
        animation-delay: 0.25s;
    }

    @keyframes slideInFromRight {
        0% {
            transform: translateX(100%);
            opacity: 0;
        }
        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }
</style>
