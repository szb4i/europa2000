---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Quote from "../sections/landing/Quote.astro";
import Hero from "../sections/landing/Hero.astro";
import Carousel from "../sections/landing/Carousel.astro";
import KikVagyunk from "../sections/landing/KikVagyunk.astro";
import MibenMas from "../sections/landing/MibenMas.astro";
import LandingSplitSlide from "../sections/landing/LandingSplitSlide.astro";
import Kepzeseink from "../sections/landing/Kepzeseink.astro";
import TamogassMinket from "../sections/landing/TamogassMinket.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/heartbeat.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="generator" content={Astro.generator} />
    </head>
    <body class="">
        <div class="header hero-element-hidden"><Header /></div>
        <Hero />
        <Carousel />
        <div class="dark-background">
            <Quote />
            <KikVagyunk />
        </div>
        <div class="light-background">
            <MibenMas />
        </div>
        <LandingSplitSlide />
        <div class="light-background">
            <Kepzeseink />
            <TamogassMinket />
        </div>
    </body>
    <div class="footer hero-element-hidden"><Footer /></div>
</html>

<script src="/src/scripts/landing.js"></script>
<style>
    .header,
    .footer {
        position: fixed;
        width: 100%;
        z-index: 3;
    }

    section {
        display: grid;
        place-items: center;
        align-content: center;
        height: 100vh;
    }

    .hero-section {
        place-items: unset;
        align-content: unset;
    }

    @media (width <= 40rem) {
        section {
            /* height: calc(100vh - 70px); */
        }
    }

    .hero-element-hidden {
        opacity: 0;
        filter: blur(5px);
        transition: ease-in 1s;
        transition-delay: 0.5s;
    }

    .hero-element-shown {
        opacity: 1;
        filter: blur(0);
    }

    @media (prefers-reduced-motion) {
        .hidden {
            transition: none;
        }
    }
</style>
