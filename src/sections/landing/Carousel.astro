---
import Button from "../../components/Button.astro";
import TestimonialSlider from "../../function-components/TestimonialSlider";
import '../../styles/light-background.css';

const testimonialList = [
    { title: "Gimnáziumi képzések", paragraph: "6 és 4 évfolyamos osztályok", imageUrl: "/landing/carousel/gimis.jpg" },
    { title: "Digitális oktatás", paragraph: "A digitális tanulás nemcsak eszköz, hanem az élményalapú oktatás alapköve. Egyedülálló technológiai háttérrel készítjük fel diákjainkat a jövő kihívásaira.", imageUrl: "/landing/carousel/digitalis.jpg" },
    { title: "7 szokás program", paragraph: "Életvezetési program a diákok harmonikus személyiségfejlődéséért.", imageUrl: "/landing/carousel/7szokas.jpg" },
    { title: "Bilingual Program", paragraph: "Felszabadult nyelvtanulás két nyelven.", imageUrl: "/landing/carousel/bilingual.jpg" },
    { title: "Film és média tagozat", paragraph: "Alkotás, kreativitás, siker az audiovizuális világban.", imageUrl: "/landing/carousel/filmes.jpg" },
    { title: "Nemzetközi vállalkozói tagozat", paragraph: "Üzleti gondolkodás, globális lehetőségek.", imageUrl: "/landing/carousel/vallalkozo.jpg" }
];
---

<section class="light-background">
    <div class="carousel-container">
        <div class="hero-element-hidden carousel-title hidden-1s">
            <p class="subtitle-text-dark">
                Az Európa 2000 Gimnázium Zugló szívében várja a diákokat, hogy
                egy inspiráló közösség részei legyenek.
            </p>
        </div>
        <div class="carousel  hidden-2s">
            <TestimonialSlider list={testimonialList} client:load />
        </div>
        <div class="hidden-1s flex flex-row justify-center gap-4 p-4">
            <div class="hidden-1s px-4 py-2">
                <Button text="Képzéseink" isBackgroundColor={true} />
            </div>
            <div class="hidden-2s px-4 py-2">
                <Button text="Részletek" isBackgroundColor={true} />
            </div>
        </div>
    </div>
</section>
<style>
    .carousel-container {
        height: 100%;
        display: grid;
        grid-template-rows: 25fr 50fr 25fr;
        justify-items: center;

        .carousel-title {
            text-align: center;
            align-content: end;
            width: 80vw;
        }

        .carousel {
            width: 80vw;
        }
    }
</style>
