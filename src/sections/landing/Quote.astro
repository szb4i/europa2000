---

import '../../styles/dark-background.css';

---

<section>
    <div class="quote-container">
        <div class="quote-text hidden-1s">
            <span class="title-text-light"
                >Olyan iskolát álmodtam meg, ahol a saját gyerekem is
            </span><span class="title-text-light green-text">örömmel </span><span
                class="title-text-light">tanulna.</span
            >
        </div>
        <div class="paragraph-text-light quote-author hidden-2s">Papp András, igazgató</div>
    </div>
</section>
<script>
    const greenTextObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("animate");
            } else {
                entry.target.classList.remove("animate");
            }
        });
    });
    const greenTextElements = document.querySelectorAll(".green-text");
    greenTextElements.forEach((el) => greenTextObserver.observe(el));
</script>
<style>
    .quote-container {
        width: 80vw;

        .quote-text {
            text-align: center;
            padding-bottom: 38px;

            .green-text {
                font-style: italic;
                padding-right: 2px;
                text-decoration: none;
                transition: color 0.3s ease-in-out 2s;
            }

            .animate {
                color: var(--Green);
            }
        }

        .quote-author {
            font-style: italic;
            text-align: end;
        }
    }
</style>
