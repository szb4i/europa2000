---
import SplitSlide from "../../components/SplitSlide.astro";
---

<SplitSlide
    isTextOnRight={false}
    textTitle="Harmónia és fejlődés"
    textParagraph="A „7 szokás” program segíti a diákokat magabiztos, felelősségteljes és kiegyensúlyozott felnőtté válni"
    imageURL="/landing/split-slide/harmonia-es-fejlodes.jpg"
/>
<SplitSlide
    isTextOnRight={true}
    textTitle="Élményalapú tanulás"
    textParagraph="Modern digitális eszközökkel és módszerekkel készítünk fel a 21. századi kihívásokra."
    imageURL="/landing/split-slide/elmenyalapu-tanulas.jpg"
/>
<SplitSlide
    isTextOnRight={false}
    textTitle="Határtalan lehetőségek"
    textParagraph="Kétnyelvű oktatásunk és nemzetközi programjaink (Erasmus+, Határtalanul) nyitottabbá és világpolgárrá formálnak."
    imageURL="/landing/split-slide/hatartalan-lehetosegek.jpg"
/>
<SplitSlide
    isTextOnRight={true}
    textTitle="Támogató közösség"
