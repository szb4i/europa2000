---
import Button from "../../components/Button.astro";
import Card from "../../components/Card.astro";
---

<div class="kiemelt-hireink-container">
    <div class="title-container title-text-dark">
        <span>Kiemelt Híreink</span>
    </div>
    <div class="news-container">
        <Card />
        <Card />
        <Card />
        <Card />
    </div>
    <Button text="További Hírek" />
</div>
<style>
    .kiemelt-hireink-container {
        justify-items: center;
        padding: 36px 0px;

        .title-container {
            text-align: center;
        }

        .news-container {
            display: flex;
            gap: 40px;
            justify-content: center;
            padding: 36px 0px;
        }

        @media (width <=770px) {
            .news-container .card-container:nth-child(n+2) {
                display: none;
            }
        }

        @media (width > 770px) and (width <= 1200px) {
            .news-container .card-container:nth-child(n+3) {
                display: none;
            }
        }
    }

    .footer-container {
        background-color: var(--Blue3);
        height: 400px;
    }
</style>
