---
import { Image } from "astro:assets";
import Button from "../../components/Button.astro";
---

<section class="hero-section">
    <div class="hero-loading"></div>
    <video
        class="hero-video hero-element-hidden"
        loop
        muted
        playsinline
        autoplay="true"
    >
        <source src="hero-video.mp4" type="video/mp4" />
    </video>
    <div class="hero-content-container">
        <div class="hero-title-container hero-title-loading">
            <Image
                src="/logo.png"
                alt="rhythm nation logo"
                width={128}
                height={128}
                format="webp"
                class="hidden-on-desktop hidden-on-tablet logo-button hero-element-hidden"
            />
            <div class="hero-title title-text-light">EUROPA2000</div>
            <div class="hero-subtitle subtitle-text-light">
                Jövőt építünk, lehetőségeket nyitunk
            </div>
        </div>
        <div class="hidden-on-mobile hero-key-link-row hero-element-hidden">
            <div class="hidden-on-tablet hero-key-link-column">
                <Button text="Szülőknek" color="#FFFFFF" />
                <Button text="Diákoknak" color="#FFFFFF" />
                <Button text="Iskolánkról" color="#FFFFFF" />
            </div>
        </div>
        <div class="hidden-on-mobile hero-bottom-row hero-element-hidden">
            <div class="hero-bottom-row-award-container">
                <div class="carousel">
                    <div class="carousel-images" id="carousel-images">
                        <Image
                            src="/landing/hero/award1.png"
                            alt="award1"
                            width={125}
                            height={125}
                            format="webp"
                            class="logo-button"
                        />
                        <Image
                            src="/landing/hero/award2.png"
                            alt="award2"
                            width={125}
                            height={125}
                            format="webp"
                            class="logo-button"
                        />
                        <Image
                            src="/landing/hero/award3.png"
                            alt="award3"
                            width={125}
                            height={125}
                            format="webp"
                            class="logo-button"
                        />
                    </div>
                </div>
            </div>
            <div class="hero-bottom-row-text-container">
                <div class="subtitle-text-light">
                    Inspiráló tanulás, magabiztos jövő – itt kezdődik a siker
                </div>
                <div class="paragraph-text-light">
                    Családias környezetben kínálunk digitális oktatást,
                    angol-magyar kétnyelvű programot, film- és médiaoktatást,
                    valamint nemzetközi vállalkozói képzést, hogy diákjaink a
                    jövő kihívásaira felkészülten léphessenek a nagyvilágba.
                </div>
            </div>
        </div>
    </div>
</section>
<script src="/src/scripts/landing.js"></script>
<script>
    const carousel = document.getElementById("carousel-images");
    const totalSlides = carousel.children.length;
    let index = 0;

    setInterval(() => {
        index = (index + 1) % totalSlides;
        carousel.style.transform = `translateX(-${index * 125}px)`;
    }, 5000);
</script>
<style>
    .hero-section {
        place-items: unset;
        align-content: unset;
    }

    .hero-loading {
        background-color: var(--Blue3);
        height: 100%;
        background-image: url("/europa2000-menu-button.png");
        background-repeat: no-repeat;
        background-position: center;
        background-size: 200px 200px;
    }

    .hero-title-loading {
        padding-top: calc(50vh - 100px); /* center vertically */
        transition: transform 0.5s ease-in-out;
        transform: translateY(0); /* initial position */
    }

    .hero-title-loaded {
        transform: translateY(-30vh); /* move up */
    }

    .hero-video {
        height: 100%;
        left: 0;
        -o-object-fit: cover;
        object-fit: cover;
        -o-object-position: center 50%;
        object-position: center 50%;
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 1;
    }

    .hero-content-container {
        width: 100%;
        height: 100%;
        text-align: center;
        font-family: "Sansation", sans-serif;
        justify-self: anchor-center;
        z-index: 2;
        position: absolute;
        display: grid;
        /* background: linear-gradient(
            117deg,
            rgba(0, 0, 0, 0) 37.28%,
            #000 99.97%
        ); */
        grid-template-rows: 25vh 37.5vh 37.5vh;
        background: radial-gradient(
            63.92% 63.92% at 50% 43.95%,
            rgba(0, 0, 0, 0) 43%,
            #000 100%
        );

        .hero-title-container {
            justify-items: center;
        }

        .hero-key-link-row {
            margin-left: calc(100% - 230px);

            .hero-key-link-column {
                height: 100%;
                align-content: end;
            }

            button {
                width: 175px;
            }
        }

        .hero-bottom-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding: 0 2rem 2rem 2rem;

            .hero-bottom-row-award-container {
                .carousel {
                    position: relative;
                    width: 125px;
                    height: 125px;
                    overflow: hidden;
                    margin: auto;
                    border-radius: 10px;
                }

                .carousel-images {
                    display: flex;
                    width: 100%;
                    height: 100%;
                    transition: transform 1s ease-in-out;
                }

                .carousel-images img {
                    width: 100%;
                    flex-shrink: 0;
                    object-fit: cover;
                }
            }

            .hero-bottom-row-text-container {
                width: 40vw;
                text-align: left;
                display: grid;
                row-gap: 8px;
            }
        }
    }

    .hero-element-hidden {
        opacity: 0;
        filter: blur(5px);
        transition: ease-in 1s;
        transition-delay: 0.5s;
    }

    .hero-element-shown {
        opacity: 1;
        filter: blur(0);
    }
</style>
