---

---
<div class="kik-vagyunk-section">
    <div class="image-zoom-container center-image">
        <div class="gsap-image image-background image-1">
            <div class="overlay-text-container">
                <div class="overlay-text-title">Kik Vagyunk?</div>
            </div>
        </div>
        <div class="gsap-image image-background image-2 hidden-images">
            <div class="overlay-text-container">
                <div class="overlay-text-title">Kik Vagyunk?</div>
            </div>
        </div>
        <div class="gsap-image image-background image-3 hidden-images">
            <div class="overlay-text-container">
                <div class="overlay-text-title">Kik Vagyunk?</div>
            </div>
        </div>
    </div>
</div>

<script>
    import "/src/scripts/horizontalScroll.js";
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);
    const imageZoomContainerElement = document.querySelector(
        ".image-zoom-container",
    );
    gsap.to(".gsap-image", {
        ease: "none",
        zoom: 2,
        scrollTrigger: {
            trigger: imageZoomContainerElement,
            pin: imageZoomContainerElement,
            start: "center center",
            end: "center top",
            scrub: true,
            invalidateOnRefresh: true,
            markers: true,
            onToggle: (params) => {
                if (!params.isActive && window.scrollY >= params.end) {
                    document
                        .querySelectorAll(".gsap-image")
                        .forEach((element) => {
                            element.classList.remove("hidden-images");
                        });
                    document
                        .querySelectorAll(".image-zoom-container")
                        .forEach((element) => {
                            element.classList.remove("center-image");
                        });
                } else if (params.isActive && window.scrollY <= params.end) {
                    document
                        .querySelectorAll(".gsap-image")
                        .forEach((element, i) => {
                            if (0 < i) {
                                element.classList.add("hidden-images");
                            }
                        });
                    document
                        .querySelectorAll(".image-zoom-container")
                        .forEach((element) => {
                            element.classList.add("center-image");
                        });
                }
            },
        },
    });

    gsap.to(".gsap-image", {
        ease: "none",
        x: () => "-200%",
        scrollTrigger: {
            trigger: imageZoomContainerElement,
            pin: imageZoomContainerElement,
            start: "1 top",
            end: () => "+=200%",
            scrub: true,
            snap: [0, 0.5, 0.995],
            markers: true,
            onToggle: (params) => {
                if (params.isActive) {
                    document
                        .querySelectorAll(".image-zoom-container")
                        .forEach((element) => {
                            element.classList.add("carousel-mode");
                        });
                } else {
                    document
                        .querySelectorAll(".image-zoom-container")
                        .forEach((element) => {
                            element.classList.remove("carousel-mode");
                        });
                }
            },
        },
    });
</script>
<style>
    .kik-vagyunk-section {
        height: 300vw;
        display: flex;
        width: 100%;
    }

    .image-background {
        --border-radius: 24px;
        background-size: cover !important;
        background-position: center !important;
        border-radius: var(--border-radius);
    }

    .carousel-mode .image-background {
        border-radius: 0px;
    }

    .image-1 {
        background: url("/landing/kik-vagyunk/kik-vagyunk-1.jpg");
    }

    .image-2 {
        background: url("/landing/kik-vagyunk/kik-vagyunk-2.jpg");
    }

    .image-3 {
        background: url("/landing/kik-vagyunk/kik-vagyunk-3.jpg");
    }

    .overlay-text-container {
        background: rgba(0, 0, 0, 0.5);
        height: 50vh;
        width: 50vw;
        font-family: "Raleway", sans-serif;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: var(--border-radius);

        .overlay-text-title {
            font-size: 38px;
        }
    }

    .carousel-mode .overlay-text-container {
        border-radius: 0px;
    }

    .image-zoom-container {
        height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
    }

    .center-image {
        justify-content: center;
    }

    .hidden-images {
        display: none;
    }
</style>
