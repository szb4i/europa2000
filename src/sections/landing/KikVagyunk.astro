<section class="kik-vagyunk-section">
    <div class="image-container horizontal-scroll-container" id="expandingDiv">
        <div class="image-background horizontal-scroll-block image-1">
            <div class="overlay-text-container">
                <div class="overlay-text-title">Kik Vagyunk?</div>
            </div>
        </div>
        <div class="image-background horizontal-scroll-block image-2">
            <div class="overlay-text-container">
                <div class="overlay-text-title">Kik Vagyunk?</div>
            </div>
        </div>
    </div>
</section>
<script>
    import "/src/scripts/horizontalScroll.js";
    function disableScroll() {
        window.addEventListener('wheel', preventScroll, { passive: false });
        window.addEventListener('touchmove', preventScroll, { passive: false }); // mobile
    }

    function enableScroll() {
        window.removeEventListener('wheel', preventScroll);
        window.removeEventListener('touchmove', preventScroll);
    }

    function preventScroll(e) {
        e.preventDefault();
    }

    // window.addEventListener("wheel", () => {
    //     console.log('wheel');
    // });

    window.addEventListener("scroll", () => {
        const range = document
            .querySelector(".kik-vagyunk-section")
            .getBoundingClientRect().height;
        const position =
            -1 *
            (document
                .querySelector(".kik-vagyunk-section")
                .getBoundingClientRect().top -
                window.innerHeight);

        const progress = Math.min(Math.max(position / range, 0.5), 1); // 0 to 1
        const maxWidth = window.innerWidth;
        const maxHeight = window.innerHeight;

        const startSize = 20;

        const width = startSize + (maxWidth - startSize) * progress;
        const height = startSize + (maxHeight - startSize) * progress;

        const expandingDiv = document.getElementById("expandingDiv");
        expandingDiv.style.width = `${width}px`;
        expandingDiv.style.height = `${height}px`;
    });

    const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
            document.querySelectorAll('.kik-vagyunk-section .horizontal-scroll-container, .kik-vagyunk-section .horizontal-scroll-block').forEach(element => {
                element.classList.add('horizontal-scroll-mode');
            });
            disableScroll();
            window.scrollTo({
                top: window.scrollY,
                behavior: 'auto' // Instantly snap
            });
            var blocks = document.getElementsByClassName("horizontal-scroll-block");
            var container = document.getElementsByClassName("horizontal-scroll-container");
            var hs = new HorizontalScroll.default({
                blocks: blocks,
                container: container,
                isAnimated: true,
                springEffect: 0.8,
            });
        } 
        // else {
        //     document.querySelectorAll('.kik-vagyunk-section .horizontal-scroll-container, .kik-vagyunk-section .horizontal-scroll-block').forEach(element => {
        //         element.classList.remove('horizontal-scroll-mode');
        //     });
        // }
    }, {threshold: 0.95});
    const observableElement = document.querySelectorAll(".kik-vagyunk-section");
    observableElement.forEach((el) => observer.observe(el));

    // document.querySelectorAll('.kik-vagyunk-section .horizontal-scroll-container, .kik-vagyunk-section .horizontal-scroll-block').forEach(element => {
    //     element.classList.add('horizontal-scroll-mode');
    // });

    // var blocks = document.getElementsByClassName("horizontal-scroll-block");
    // var container = document.getElementsByClassName("horizontal-scroll-container");
    // var hs = new HorizontalScroll.default({
    //     blocks: blocks,
    //     container: container,
    //     isAnimated: true,
    //     springEffect: 0.8,
    // });
        
</script>
<style>
    .kik-vagyunk-section {
        overflow: hidden;
    }

    .image-container {
        position: relative;
    }
    
    .image-background {
        --border-radius: 24px;
        height: 100%;
        width: 100%;
        background-size: cover;
        background-position: center;
        border-radius: var(--border-radius);
    }
    
    .horizontal-scroll-mode {
        width: 100vw;
        height: 100vh;
    }

    .image-1 {
        background: url("/landing/kik-vagyunk/kik-vagyunk-1.jpg") no-repeat 50% 50%;
    }

    .image-2 {
        background: url("/landing/kik-vagyunk/kik-vagyunk-2.jpg") no-repeat 50% 50%;
    }

    .overlay-text-container {
        background: rgba(0, 0, 0, 0.5);
        width: 100%;
        height: 100%;
        font-family: "Raleway", sans-serif;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: var(--border-radius);

        .overlay-text-title {
            font-size: 38px;
        }
    }

    .kik-vagyunk-section {
        height: 100vh;
        place-items: unset;
        align-content: unset;
        justify-content: center;
    }

    .expanding-div {
        /* position: fixed;
        top: 0;
        left: 0; */
        background: #4caf50;
        width: 100px;
        height: 100px;
        transition:
            width 0.1s ease-out,
            height 0.1s ease-out;
        z-index: 10;
    }
</style>
