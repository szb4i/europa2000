<div class="image-zoom-section">
    <div class="image-zoom-container center-image">
        <img src="/landing/kik-vagyunk/kik-vagyunk-1.jpg" class="gsap-image" alt="" />
        <img src="/landing/kik-vagyunk/kik-vagyunk-2.jpg" class="gsap-image hidden-images" alt="" />
        <img src="/landing/kik-vagyunk/kik-vagyunk-3.jpg" class="gsap-image hidden-images" alt="" />
    </div>
</div>

<script>
    import "/src/scripts/horizontalScroll.js";
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);
    const imageZoomContainerElement = document.querySelector(".image-zoom-container");
	gsap.to(".gsap-image", {
		ease: "none",
		scale: 2,
		scrollTrigger: {
			trigger: imageZoomContainerElement,
			pin: imageZoomContainerElement,
			start: "center center",
			end: "center top",
			scrub: true,
			invalidateOnRefresh: true,
			markers: true,
			onToggle: (params) => {
				console.log(`${params.isActive} ${window.scrollY} ${params.start} ${params.end}`)
				if (!params.isActive && window.scrollY >= params.end) {
					document.querySelectorAll('.gsap-image').forEach(element => {
						element.classList.remove('hidden-images');
                        element.classList.add('gsap-image-carousel-mode');
					});
                    document.querySelectorAll('.image-zoom-container').forEach(element => {
						element.classList.remove('center-image');
					});
				} else if (params.isActive && window.scrollY <= params.end) { 
					document.querySelectorAll('.gsap-image').forEach((element, i) => {
						if (0 < i) {
							element.classList.add('hidden-images');
						}
                        element.classList.remove('gsap-image-carousel-mode');
					});
                    document.querySelectorAll('.image-zoom-container').forEach(element => {
						element.classList.add('center-image');
					});
				}
			},
		},
	});

    gsap.to(".gsap-image", {
		ease: "none",
		x: () => '-400%',
		scrollTrigger: {
            trigger: imageZoomContainerElement,
			pin: imageZoomContainerElement,
			start: "1 top",
			end: () => "+=800%",
			scrub: true,
            snap: [0, 0.5, 0.995],
			markers: true,
			onToggle: (params) => {
				console.log(params.isActive)
			},
		},
	});
</script>
<style>
    body {
        /* overflow-x: hidden; */
    }

    .kik-vagyunk-section {
        height: 200vh;
        place-items: unset;
        align-content: unset;
        justify-content: center;
    }

    .expanding-image-container {
        /* gap: 16px; */
        /* height: 100vh; */
        height: 25vh;
        overflow: hidden;
    }
    
    .img-gsap-vertical-scroll-container {
        display: flex;
        flex-direction: row;
        /* gap: 16px; */
        height: 100vh;
        width: 300vh;
        overflow: hidden;
    }

    .image-background {
        --border-radius: 24px;
        /* height: 100%;
        width: 100%; */
        background-size: cover;
        background-position: center;
        border-radius: var(--border-radius);
        height: 50vh;
        /* 100vw !important; */
        width: 50vw;
    }

    .image-1 {
        background: url("/landing/kik-vagyunk/kik-vagyunk-1.jpg");
    }

    .image-2 {
        background: url("/landing/kik-vagyunk/kik-vagyunk-2.jpg");
    }

    .image-3 {
        background: url("/landing/kik-vagyunk/kik-vagyunk-3.jpg");
    }

    .overlay-text-container {
        background: rgba(0, 0, 0, 0.5);
        height: 100%;
        width: 100vw;
        font-family: "Raleway", sans-serif;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: var(--border-radius);

        .overlay-text-title {
            font-size: 38px;
        }
    }

    .image-zoom-section {
		height: 700vw;
        display: flex;
        width: 100%;
	}

    .image-zoom-container {
        height: 100vh;
        width: 100%;
        display: flex;
		align-items: center;
    }

    .center-image {
        justify-content: center;
    }

    .hidden-images {
		display: none;
	}

    .gsap-image {
        height: 50vh;
        width: auto;
        /* height: 100vh; */
    }

    .gsap-image-carousel-mode {
        height: 100vh;
        object-fit: cover;
        scale: 0.5 !important;
    }
</style>
