---
import Button from "../../components/Button.astro";
import ImageFullWithText from "../../components/ImageFullWithText.astro";
---

<section class="tamogass-minket">
    <ImageFullWithText imageURL="/landing/tamogass-minket/tamogass-minket.jpg">
        <div class="overlay-text-title title-text-light">
            <span>Támogass Minket!</span>
        </div>
        <div class="overlay-text-subtitle subtitle-text-light">
            <span
                >Ajánlja fel adója 1%-át, és legyen részese diákjaink
                sikereinek!</span
            >
        </div>
        <div class="overlay-text-paragraph paragraph-text-light">
            <span
                >Felajánlása az Európa 2000 Oktatási Központ Alapítványát
                segíti, amely közhasznú szervezetként a diákok fejlődését
                helyezi előtérbe. Az így befolyt összegekből modern digitális
                eszközöket, innovatív tanulási alkalmazásokat és fejlesztéseket
                biztosítunk, hogy tanulóink a legkorszerűbb tudással és
                készségekkel váljanak a jövő sikeres felnőttjeivé.</span
            >
        </div>
        <div class="button-row">
            <Button text="Támogatom" color="#FFFFFF" />
        </div>
    </ImageFullWithText>
</section>
<style>
    .tamogass-minket {
        .overlay-text-title {
            padding-bottom: 32px;
        }

        .overlay-text-subtitle {
            padding-bottom: 32px;
        }

        .overlay-text-paragraph {
            padding-bottom: 32px;
        }
    }
</style>
